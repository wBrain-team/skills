// Matriz ampla: todas as páginas × tema × tamanho (comfortable) + compact no laptop. Centenas de imagens:
// use `make visual filter=<trecho>` para limitar.
import { mkdirSync, rmSync } from "node:fs"
import path from "node:path"
import { SIZES, type SizeName } from "../../playwright.config"
import { hasOverflow, KEYS, slug, test } from "../../fixtures"

const ROOT = path.join(process.env.E2E_TEMP || "/temp", "screenshot", "matrix")
const filter = process.env.SHOT_FILTER

test("matriz de todas as páginas", async ({ browser, baseURL }) => {
  const combos = (["dark", "light"] as const).flatMap((theme) => [
    ...(Object.keys(SIZES) as SizeName[]).map((size) => ({ theme, density: "comfortable", size })),
    { theme, density: "compact", size: "laptop" as SizeName },
  ])
  const base = { baseURL, reducedMotion: "reduce" as const }

  // ADAPTAR: seletor dos links do menu (descoberta das rotas) e do conteúdo principal.
  const probe = await browser.newContext({ ...base, viewport: SIZES.laptop })
  const probePage = await probe.newPage()
  await probePage.goto("/")
  await probePage.waitForSelector("nav a[href^='#/']")
  let routes = await probePage.$$eval("nav a[href^='#/']", (as) => [...new Set(as.map((a) => a.getAttribute("href")!.slice(1)))])
  await probe.close()
  if (filter) routes = routes.filter((r) => r.includes(filter))
  test.skip(!routes.length, `Nenhuma rota casa com "${filter}"`)

  rmSync(ROOT, { recursive: true, force: true })
  const signals: string[] = []
  for (const { theme, density, size } of combos) {
    const context = await browser.newContext({ ...base, viewport: SIZES[size] })
    await context.addInitScript(
      ([keys, t, d]) => {
        localStorage.setItem(keys.theme, t)
        localStorage.setItem(keys.density, d)
        localStorage.setItem(keys.lang, "pt-BR")
      },
      [KEYS, theme, density] as const,
    )
    const page = await context.newPage()
    const tag = `${theme}/${density}/${size}`
    page.on("pageerror", (e) => signals.push(`erro de JS (${tag}): ${e.message}`))
    const dir = path.join(ROOT, `${theme}-${density}-${size}`)
    mkdirSync(dir, { recursive: true })
    for (const route of routes) {
      await page.goto(`/#${route}`)
      await page.waitForSelector("main h1, main h2, #root h1")
      await page.evaluate(() => document.fonts.ready)
      if (await hasOverflow(page)) signals.push(`overflow horizontal: ${route} (${tag})`)
      await page.screenshot({ path: path.join(dir, `${slug(route)}.png`), fullPage: true })
    }
    await context.close()
  }
  console.log(`  - ./temp/screenshot/matrix (${routes.length} páginas × ${combos.length} combinações)`)
  if (signals.length) console.log(`\nSinais a investigar:\n${[...new Set(signals)].map((s) => `  ! ${s}`).join("\n")}`)
  test.info().annotations.push({ type: "sinais", description: String(signals.length) })
  if (signals.length) throw new Error(`${signals.length} sinal(is) objetivo(s) de problema (ver acima)`)
})
