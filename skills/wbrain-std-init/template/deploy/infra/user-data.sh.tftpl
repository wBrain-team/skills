#!/bin/bash
# Formata (se vazio) e monta o volume de dados persistente em /ext-vol. Idempotente.
set -euo pipefail

MOUNT_POINT=/ext-vol
DEVICE=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${data_volume_id}

for _ in $(seq 1 60); do
  [ -e "$DEVICE" ] && break
  sleep 5
done
[ -e "$DEVICE" ] || { echo "volume de dados nao apareceu: $DEVICE" >&2; exit 1; }

if ! blkid "$DEVICE" >/dev/null 2>&1; then
  mkfs.ext4 -L ext-vol "$DEVICE"
fi

mkdir -p "$MOUNT_POINT"
UUID=$(blkid -s UUID -o value "$DEVICE")
grep -q "$UUID" /etc/fstab || echo "UUID=$UUID $MOUNT_POINT ext4 defaults,nofail 0 2" >> /etc/fstab
mountpoint -q "$MOUNT_POINT" || mount "$MOUNT_POINT"
%{ if swap_size_gb > 0 }
# Swap em arquivo no volume raiz (o volume de dados fica só para dados).
SWAPFILE=/swapfile
if ! swapon --show=NAME --noheadings | grep -qx "$SWAPFILE"; then
  [ -f "$SWAPFILE" ] || {
    fallocate -l ${swap_size_gb}G "$SWAPFILE"
    chmod 600 "$SWAPFILE"
    mkswap "$SWAPFILE"
  }
  swapon "$SWAPFILE"
fi
grep -q "^$SWAPFILE " /etc/fstab || echo "$SWAPFILE none swap sw 0 0" >> /etc/fstab
%{ endif ~}
